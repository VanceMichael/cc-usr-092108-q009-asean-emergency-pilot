  "degradation_policy": {
    "triggers": [
      { "kind": "network_outage", "threshold": "心跳丢失持续120秒（广平站60秒）", "to_mode": "advisory_only" },
      { "kind": "sensor_drift", "threshold": "同一传感器与邻近参照偏差>15%持续10分钟", "to_mode": "assisted" },
      { "kind": "confidence_drop", "threshold": "综合置信度<0.75", "to_mode": "advisory_only" },
      { "kind": "confidence_drop", "threshold": "综合置信度<0.60", "to_mode": "manual" }
    ],
    "modes": [
      { "mode": "autonomous", "rank": 0, "system_may_emit_alert": true, "description": "系统可自动发布预警" },
      { "mode": "assisted", "rank": 1, "system_may_emit_alert": true, "description": "系统建议、人工确认后发布" },
      { "mode": "advisory_only", "rank": 2, "system_may_emit_alert": false, "description": "仅向值守人员提供建议，不得自动对外发布" },
      { "mode": "manual", "rank": 3, "system_may_emit_alert": false, "description": "完全人工流程，系统只显示数据" }
    ],
    "manual_takeover_required": true,
    "takeover_record_fields": ["trigger_kind", "from_mode", "to_mode", "operator", "began_at_utc", "resolution"]
