{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "并发事件时间线",
  "description": "多方签署、并行部署、时区差异、台风事件、资金里程碑与成果撤回可能同时发生。所有事件以 UTC 排序；各国独立持有本地风险与处置；撤回即时冻结扩大推广，主办方只能依据真实演练与运行证据决策。",
  "type": "object",
  "required": ["domain", "doc_version", "events"],
  "properties": {
    "domain": { "const": "asean-emergency-pilot" },
    "doc_version": { "type": "integer", "minimum": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["event_id", "at_utc", "kind", "country_scope"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^evt-[a-z0-9-]+$" },
        "at_utc": {
          "type": "string",
          "description": "ISO-8601 UTC 时间戳，全部比较与排序只使用此字段"
        },
        "local_time_context": {
          "type": "object",
          "description": "仅供展示，不参与任何先后判断",
          "properties": {
            "timezone": { "type": "string" },
            "local_text": { "type": "string" }
          },
          "additionalProperties": false
        },
        "kind": {
          "enum": [
            "multiparty_signoff",
            "parallel_deployment",
            "typhoon_phase",
            "funding_milestone",
            "withdrawal",
            "drill_run",
            "scale_up_decision"
          ]
        },
        "country_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["VN", "TH", "ID", "MY", "PH", "SG", "KH", "ASEAN"]
          }
        },
        "product_id": { "type": "string" },
        "phase": {
          "type": "string",
          "description": "typhoon_phase 事件必填：台风所处相位，顺序为 formation→approach→landfall→flood→post_event",
          "enum": ["formation", "approach", "landfall", "flood", "post_event"]
        },
        "detail": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
